<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- IdleHarvest Theme (Dark) -->
    <style name="Theme.IdleHarvest" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/ih_dark_bg</item>
        <item name="android:navigationBarColor">@color/ih_dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/ih_dark_bg</item>
    </style>

    <!-- Splash Screen Theme (Dark) -->
    <style name="Theme.IdleHarvest.Splash" parent="Theme.IdleHarvest">
        <item name="android:windowBackground">@color/ih_primary_green_dark</item>
        <item name="android:statusBarColor">@color/ih_primary_green_dark</item>
    </style>
</resources>
